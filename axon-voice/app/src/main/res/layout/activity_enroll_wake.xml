<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enroll_title"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enroll_intro"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/wakePhraseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enroll_phrase_hint"
            android:inputType="text"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/enrollStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/enrollLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/enrollRecordBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enroll_record" />

            <Button
                android:id="@+id/enrollRerecordBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/enroll_rerecord_btn" />
        </LinearLayout>

        <Button
            android:id="@+id/enrollBuildBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="@string/enroll_build_btn" />

        <TextView
            android:id="@+id/enrollResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_dim" />
    </LinearLayout>
</ScrollView>
