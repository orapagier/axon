<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact colored buttons for Settings — smaller than stock Material3
         buttons (which carry ~12dp vertical insets on top of padding) and
         filled with the app's accent instead of a flat outline, so the
         screen reads less like a wall of identical gray rectangles. -->
    <style name="Widget.Axon.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bg</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.Axon.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="strokeColor">@color/accent</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- "Needs your attention" — permission/setup buttons that still require
         a tap. Turned muted (see SettingsActivity#tintGranted) once granted. -->
    <style name="Widget.Axon.Button.Warning" parent="Widget.Axon.Button">
        <item name="android:textColor">@color/bg</item>
        <item name="backgroundTint">@color/warning</item>
    </style>

    <!-- Thin separator between Settings sections — replaces large empty
         margins with a hairline so sections stay visually distinct without
         wasting vertical space. -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@color/accent_dim</item>
    </style>
</resources>
